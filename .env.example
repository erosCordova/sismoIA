# Supabase es la base principal. Usar los datos de conexion del proyecto propio.
# No utilizar estos valores de ejemplo como secretos reales ni publicar .env.
DATABASE_URL=postgresql+psycopg://USUARIO:CLAVE@HOST_SUPABASE:5432/postgres?sslmode=require
JWT_SECRET_KEY=REEMPLAZAR_CON_UN_SECRETO_ALEATORIO_DE_AL_MENOS_48_CARACTERES
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SISMOIA_EMAIL_ENABLED=false
# PostgreSQL local es opcional: generar .env.local con setup_local_env.py
# y seleccionar explicitamente SISMOIA_TARGET=local en la terminal del backend.
# Solo para scripts historicos anteriores; la exploracion web selecciona su fuente.
# SISMOIA_FORECAST_SOURCE_NAME=IGP
# Directorio opcional de artefactos ML; por defecto services/api/data/processed.
# SISMOIA_ML_OUTPUT_DIR=C:/ruta/artefactos
# Correo opcional: completar con credenciales propias antes de activarlo.
# SISMOIA_SMTP_HOST=smtp.ejemplo.com
# SISMOIA_SMTP_PORT=465
# SISMOIA_SMTP_SECURITY=ssl
# SISMOIA_SMTP_USER=usuario
# SISMOIA_SMTP_PASSWORD=REEMPLAZAR
# SISMOIA_SMTP_FROM=avisos@ejemplo.com
